# ─── Telegram ────────────────────────────────────────────────
# Get from @BotFather
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Your personal Telegram chat ID — makes you the admin
# Get it by messaging @userinfobot on Telegram
ADMIN_CHAT_ID=your-telegram-chat-id

# ─── Database (PostgreSQL) ────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=yourpassword
DB_NAME=price_alert_bot

# ─── App ─────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development   # change to 'production' on Railway

# ─── Webhook (production only) ────────────────────────────────
# Your Railway public URL — no trailing slash
# Example: https://price-alert-bot-production.up.railway.app
WEBHOOK_URL=

# ─── Finnhub (EMA alerts) ────────────────────────────────────
# Server-level key — users do not need to provide this
FINNHUB_API_KEY=your-finnhub-api-key-here
